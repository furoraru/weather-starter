{
  "request": {
    "method": "GET",
    "urlPath": "/v1/current.json",
    "queryParameters": {
      "key": {
        "equalTo": "test-api-key"
      },
      "q": {
        "equalTo": "Moscow"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "weather/success/moscow.json"
  }
}